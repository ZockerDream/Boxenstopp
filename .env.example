# Boxenstopp – Umgebung. Kopieren nach .env und Werte setzen (scripts/gen-secrets.sh erzeugt sie).
APP_PORT=8090
IMAGE_TAG=0.3.0
TZ=Europe/Berlin

# Werden nur beim ersten Start in ein leeres Datenbank-Volume übernommen
DB_USER=boxenstopp
DB_PASSWORD=bitte-aendern
DB_NAME=boxenstopp

# Schlüssel für 2FA-Geheimnisse und Webhook-URLs. Nach dem ersten Start nicht mehr ändern.
ENCRYPTION_KEY=bitte-aendern

# Hinter einem Reverse-Proxy auf 1 setzen (echte Client-IP für Login-Sperre und Audit-Log)
TRUST_PROXY=0
# Bei HTTPS über einen Proxy auf 1 setzen (Cookies nur über HTTPS)
SECURE_COOKIES=0
BACKUP_RETENTION_DAYS=14
